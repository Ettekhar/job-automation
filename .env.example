# Copy this file to .env and fill in the values you're using.

# --- SMTP Email Notifications ---
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USER=taion@razibmarketing.net
SMTP_PASS=your-smtp-password
SMTP_FROM="Teletalk Job Alert" <taion@razibmarketing.net>
NOTIFY_EMAIL=taion@razibmarketing.net

# Optional: Resend API (Alternative email provider)
RESEND_API_KEY=
# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pre-check each new Teletalk match's application form for hard restrictions
# (diploma-only education row, mandatory minimum experience, ...) and send an
# eligibility-warning email instead of an "Apply now" alert. The check only
# reads the form; it never fills or submits it. Set to 0 to disable.
ELIGIBILITY_CHECK=1

# Optional: Bangladeshi residential proxy for erecruitment.bb.org.bd.
# The BB portal's anti-bot layer rejects cloud/datacenter IPs (GitHub Actions,
# Cloudflare, ...) with a CAPTCHA — only BD residential IPs get the job list.
# That's why the local runner (scripts/bb-local-run.ps1, npm run check:bb)
# handles BB from this PC. Setting this proxy lets the GitHub cron scan BB too.
# Format: http://user:pass@host:port
BB_PROXY_URL=

# --- autofill (scripts/autofill.mjs) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Dashboard Server ---
PORT=3000

# ── FREE AI FALLBACK PROVIDERS (cascade: Gemini → OpenRouter → Groq → Cloudflare) ──
# Fill any you have — the system tries each in order and falls back automatically.

# OpenRouter — free signup at https://openrouter.ai/keys
# Free vision model: meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_API_KEY=

# Groq — free signup at https://console.groq.com/keys (very fast)
GROQ_API_KEY=

# Cloudflare Workers AI — https://dash.cloudflare.com → AI → Workers AI (100,000 req/day free)
# Account ID: Workers & Pages → Overview → right sidebar
# API Token: My Profile → API Tokens → Create Token → "Cloudflare Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=
